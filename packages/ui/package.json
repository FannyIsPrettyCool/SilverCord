{
  "name": "@silvercord/ui",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./global.css": "./src/styles/global.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.visual.json",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:visual": "pnpm build-storybook && playwright test",
    "test:visual:update": "pnpm build-storybook && playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@silvercord/config": "workspace:*",
    "@storybook/react": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "fast-check": "4.10.2",
    "postcss-nesting": "14.0.3",
    "storybook": "10.6.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/noto-color-emoji": "5.3.2",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "motion": "14.3.0",
    "ogl": "1.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
