{
  "name": "@silvercord/desktop",
  "version": "0.3.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.config.ts --dir",
    "test:package": "pnpm package:dir && node scripts/check-fuses.ts",
    "ui:shots": "electron-vite build && playwright test --config playwright.shots.config.ts"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@silvercord/config": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "postcss-nesting": "14.0.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@silvercord/markdown": "workspace:*",
    "@silvercord/permissions": "workspace:*",
    "@silvercord/protocol": "workspace:*",
    "@silvercord/ui": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-virtual": "3.14.13",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "blurhash": "2.0.5",
    "emojibase": "17.0.0",
    "emojibase-data": "17.0.0",
    "i18next": "26.5.0",
    "i18next-icu": "2.6.1",
    "intl-messageformat": "12.1.3",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "description": "SilverCord desktop client",
  "author": "SilverCord"
}
