{
  "name": "@silvercord/server",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate-cli.ts",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@node-rs/argon2": "2.2.2",
    "@silvercord/protocol": "workspace:*",
    "close-with-grace": "2.5.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.1.2",
    "openapi-types": "12.1.3",
    "otpauth": "9.5.2",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@silvercord/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.1"
  }
}
