# syntax=docker/dockerfile:1
# Verified Docker Hub manifest, 2026-10-18; update deliberately with Node LTS.
FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS dependencies
WORKDIR /workspace
RUN npm install --global pnpm@11.26.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/server/package.json apps/server/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/markdown/package.json packages/markdown/package.json
COPY packages/permissions/package.json packages/permissions/package.json
COPY packages/config/package.json packages/config/package.json
COPY tools/commitlint/package.json tools/commitlint/package.json
RUN pnpm --filter @silvercord/server... install --prod --frozen-lockfile --ignore-scripts
COPY apps/server/src apps/server/src
COPY packages/protocol/src packages/protocol/src
COPY packages/markdown/src packages/markdown/src
COPY packages/permissions/src packages/permissions/src
# Deploy makes workspace dependencies portable; these packages export TS source.
RUN pnpm --filter @silvercord/server deploy --prod --legacy --ignore-scripts /opt/server

FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS api
ENV NODE_ENV=production
WORKDIR /app
COPY --from=dependencies --chown=node:node /opt/server/ ./
COPY --from=dependencies /workspace/packages/protocol/package.json /workspace-packages/protocol/package.json
COPY --from=dependencies /workspace/packages/protocol/src /workspace-packages/protocol/src
COPY --from=dependencies /workspace/packages/markdown/package.json /workspace-packages/markdown/package.json
COPY --from=dependencies /workspace/packages/markdown/src /workspace-packages/markdown/src
COPY --from=dependencies /workspace/packages/permissions/package.json /workspace-packages/permissions/package.json
COPY --from=dependencies /workspace/packages/permissions/src /workspace-packages/permissions/src
# Node does not strip TypeScript under node_modules. Workspace source dependencies
# are deliberately copied outside it and linked back; external packages stay JS.
RUN for package in protocol markdown permissions; do \
      rm -r "node_modules/@silvercord/$package" && \
      ln -s "/workspace-packages/$package" "node_modules/@silvercord/$package" && \
      ln -s /app/node_modules "/workspace-packages/$package/node_modules"; \
    done
# Named volumes copy this ownership on first mount, so the nonroot user can write media.
RUN install -d -o node -g node -m 750 /data /data/media /data/jobs
USER node
EXPOSE 4000
CMD ["node", "src/main.ts"]

# Media decoder (ADR-0009): same code plus ffmpeg, run with no network and no secrets.
FROM api AS decoder
USER root
RUN apt-get update && \
    apt-get install --yes --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*
USER node
CMD ["node", "src/modules/media/decoder/decoder-main.ts", "/data/jobs"]
