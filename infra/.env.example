# Copy OUTSIDE the checkout to /etc/silvercord/production.env; chmod 600.
# Generate each hex password separately: openssl rand -hex 32
POSTGRES_PASSWORD=
DATABASE_PASSWORD=
JWT_SECRET=
# Exactly 32 random bytes, base64: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
MAIL_FROM='SilverCord <no-reply@silvercord.islandmon.cloud>'
# Real delivery requires an operator-supplied SMTP URL and authorized sender.
SMTP_URL=
COMPOSE_PROFILES=
# Private test inbox ONLY: set BOTH lines below in the private environment file.
# COMPOSE_PROFILES=staging
# SMTP_URL=smtp://mailpit:1025
