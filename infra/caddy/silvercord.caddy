# Import these additional sites from the existing host Caddyfile after DNS resolves.
# Keep play.islandmon.cloud and its handlers unchanged.
silvercord.islandmon.cloud {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# Private media bytes are available only through the separate CDN origin.
	@media path /media /media/*
	handle @media {
		respond 404
	}
	@backend path /api /api/* /gateway /gateway/* /health
	handle @backend {
		# Caddy sets X-Forwarded-* and ignores untrusted incoming forwarding headers.
		reverse_proxy 127.0.0.1:14000
	}
	handle_path /downloads/* {
		root * /srv/silvercord-downloads
		header Content-Disposition attachment
		header Cache-Control no-cache
		file_server
	}
	handle {
		root * /srv/silvercord-site/current
		header Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		header Cache-Control no-cache
		file_server
	}
}

cdn.silvercord.islandmon.cloud {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# The API route checks the bearer session, current membership and block state.
	handle /media/* {
		reverse_proxy 127.0.0.1:14000
	}
	handle {
		respond 404
	}
}
