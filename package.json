{
  "name": "@silvercord/root",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@silvercord/server --filter=@silvercord/desktop",
    "dev:stack": "docker compose -f infra/docker-compose.dev.yml up -d --wait",
    "dev:stack:down": "docker compose -f infra/docker-compose.dev.yml down",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "pnpm lint && turbo run typecheck test --affected",
    "verify:all": "pnpm lint && turbo run typecheck test",
    "verify:full": "pnpm verify:all && turbo run test:integration test:e2e",
    "ui:shots": "turbo run ui:shots",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "release": "turbo run release",
    "prepare": "lefthook install",
    "lint:commits": "sh tools/commitlint/lint-range.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@silvercord/commitlint": "workspace:*",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
